# Neon (Postgres) database connection
# Get these from your Neon dashboard: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/hunterrr"

# Better Auth
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Single-user lock: only this email can sign in via Google
# Who may sign in: comma-separated list (the first is you). The older single ALLOWED_EMAIL still works.
ALLOWED_EMAILS="you@example.com,friend1@example.com"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NVIDIA API (for LLM skill extraction in ETL, not used directly in web app)
# NVIDIA_API_KEY="your-nvidia-api-key-here"